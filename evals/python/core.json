    {
      "id": "core-units-in-names",
      "prompt": "Add a 20 MB size limit and a request timeout to upload() in storage/upload.py.",
      "files": {
        "pyproject.toml": "[project]\nname = \"app\"\nversion = \"0.1.0\"\nrequires-python = \">=3.13\"\ndependencies = [\n]\n",
        "storage/__init__.py": "",
        "storage/upload.py": "from typing import Protocol\n\n\nclass ObjectStorage(Protocol):\n    def put(self, key: str, content: bytes, *, timeout: float) -> str: ...\n\n\ndef upload(key: str, content: bytes, *, storage: ObjectStorage) -> str:\n    return storage.put(key, content, timeout=30)\n"
      },
      "code": [
        {
          "files": "**/*.py",
          "match": "[A-Z_]*BYTES|_bytes\\b",
          "why": "the size carries its unit"
        },
        {
          "files": "**/*.py",
          "match": "SECONDS|_seconds\\b",
          "why": "the timeout carries its unit"
        }
      ]
    },
